{
 "module": "mc_src",
 "role": "module",
 "lang": "py",
 "params": [],
 "domains": [
  {"name": "sys", "clock": "clk", "edge": "pos",
   "reset": {"port": "rst_n", "active": "low", "async": true}},
  {"name": "slow", "clock": "clk_slow", "edge": "pos", "sync_to": {"domain": "sys", "div": 2},
   "reset": {"port": "rst_slow_n", "active": "low", "async": true}}
 ],
 "ports": [
  {"bundle": "s", "protocol": "valid_ready", "role": "sink", "domain": "sys", "signals": [
   {"name": "s_valid", "dir": "input", "type": "logic"},
   {"name": "s_ready", "dir": "output", "type": "logic", "kind": "wire"},
   {"name": "s_data", "dir": "input", "type": "logic [7:0]"}]},
  {"bundle": "m", "protocol": "valid_ready", "role": "source", "domain": "sys", "signals": [
   {"name": "m_valid", "dir": "output", "type": "logic", "kind": "wire"},
   {"name": "m_ready", "dir": "input", "type": "logic"},
   {"name": "m_data", "dir": "output", "type": "logic [7:0]", "kind": "wire"}]},
  {"name": "soft_rst", "dir": "input", "type": "logic", "domain": "sys"},
  {"name": "cnt", "dir": "output", "type": "logic [3:0]", "domain": "slow", "kind": "reg", "reset": "'0"}
 ],
 "signals": [
  {"name": "buf_v", "kind": "reg", "type": "logic", "domain": "sys", "reset": "1'b0"},
  {"name": "buf_d", "kind": "reg", "type": "logic [7:0]", "domain": "sys", "reset": "'0"},
  {"name": "fire_q", "kind": "reg", "type": "logic", "domain": "sys", "reset": "1'b0"}
 ],
 "blocks": [
  {"id": "k_ready", "kind": "comb",
   "body": "s_ready = rst_n and not soft_rst and (not buf_v or m_ready)\nm_valid = buf_v\nm_data = buf_d"},
  {"id": "k_buf", "kind": "seq", "domain": "sys",
   "body": "fire_q = s_valid and s_ready\nif soft_rst:\n    buf_v = False\n    buf_d = 0\nelif s_valid and s_ready:\n    buf_v = True\n    buf_d = s_data + 1\nelif m_ready:\n    buf_v = False"},
  {"id": "k_cnt", "kind": "seq", "domain": "slow", "body": "if fire_q:\n    cnt = cnt + 1"}
 ]
}
