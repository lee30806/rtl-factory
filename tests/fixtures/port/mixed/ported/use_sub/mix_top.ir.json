  {
   "name": "y2",
   "dir": "output",
   "type": "logic [DW-1:0]",
   "domain": "sys",
   "kind": "wire"
  }
 ],
 "types": [
  {
   "name": "st_t",
   "kind": "enum",
   "base": "logic [1:0]",
   "members": [
    "S_IDLE",
    "S_RUN",
    "S_DONE"
   ]
  }
 ],
 "signals": [
  {
   "name": "s_0",
   "kind": "wire",
   "type": "logic [DW-1:0]"
  },
  {
   "name": "s_1",
   "kind": "wire",
   "type": "logic [DW-1:0]"
  },
  {
   "name": "s_extra",
   "kind": "wire",
   "type": "logic [DW-1:0]"
  },
  {
   "name": "st",
   "kind": "reg",
   "type": "st_t",
   "domain": "sys",
   "reset": "S_IDLE"
  }
 ],
 "blocks": [
  {
   "id": "k_st",
   "kind": "seq",
   "domain": "sys",
   "reads": [
    "st",
    "go",
    "s_0"
   ],
   "writes": [
    "st"
   ],
   "body": "case (st)\n  S_IDLE: if (go) st <= S_RUN;\n  S_RUN: if (s_0 >= DW'(K)) st <= S_DONE;\n  default: st <= S_IDLE;\nendcase"
  },
  {
   "id": "k_out",
   "kind": "comb",
   "reads": [
    "st",
    "s_0",
    "s_1",
    "s_extra"
   ],
   "writes": [
    "state",
    "busy",
    "y0",
    "y1",
    "y2"
   ],
   "body": "state = st;\nbusy = (st != S_IDLE);\ny0 = s_0;\ny1 = s_1;\ny2 = s_extra;"
  }
 ],
 "instances": [
  {
   "name": "u_acc_0",
   "module": "acc",
