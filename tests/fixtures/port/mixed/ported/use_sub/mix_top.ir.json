{
 "module": "mix_top",
 "role": "module",
 "params": [
  {
   "name": "N",
   "type": "int",
   "default": "2"
  },
  {
   "name": "DW",
   "type": "int",
   "default": "8",
   "local": true
  },
  {
   "name": "K",
   "type": "int",
   "default": "3",
   "local": true
  }
 ],
 "domains": [
  {
   "name": "sys",
   "clock": "clk",
   "edge": "pos",
