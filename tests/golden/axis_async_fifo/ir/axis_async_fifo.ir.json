  {
   "id": "k_s_comb",
   "kind": "comb",
   "reads": [
    "wr_ptr_reg",
    "wr_ptr_gray_reg",
    "rd_ptr_gray_sync2_reg",
    "s_rst_sync3_reg",
    "s_axis_tuser",
    "s_axis_tdest",
    "s_axis_tid",
    "s_axis_tlast",
    "s_axis_tdata",
    "s_pause_ack_sync3_reg",
    "full",
    "wr_ptr_inc",
    "m_side_ready_sync"
   ],
   "writes": [
    "wr_ptr_inc",
    "wr_ptr_inc_gray",
    "full",
    "s_axis_tready",
    "s_axis_word",
    "s_status_bad_frame",
    "s_status_good_frame",
    "s_pause_ack",
    "s_rst_sync3_reg"
   ],
   "body": "s_rst_sync3_reg = !m_side_ready_sync;\nwr_ptr_inc = wr_ptr_reg + 1'b1;\nwr_ptr_inc_gray = wr_ptr_inc ^ (wr_ptr_inc >> 1);\nfull = wr_ptr_gray_reg == (rd_ptr_gray_sync2_reg ^ {2'b11, {(ADDR_WIDTH-1){1'b0}}});\ns_axis_tready = !full && !s_rst_sync3_reg;\ns_axis_word = {s_axis_tuser, s_axis_tdest, s_axis_tid, s_axis_tlast, s_axis_tdata};\ns_status_bad_frame = 1'b0;\ns_status_good_frame = 1'b0;\ns_pause_ack = s_pause_ack_sync3_reg;"
  },
  {
   "id": "k_s_g2b",
   "kind": "comb",
   "reads": [
    "rd_ptr_gray_sync2_reg"
   ],
   "writes": [
    "rd_ptr_sync_bin"
   ],
   "body": "rd_ptr_sync_bin = '0;\nfor (int i = 0; i <= ADDR_WIDTH; i++) begin\n  rd_ptr_sync_bin[i] = ^(rd_ptr_gray_sync2_reg >> i);\nend"
  },
  {
   "id": "k_wr",
   "kind": "seq",
   "domain": "s",
   "reads": [
    "s_axis_tready",
    "s_axis_tvalid",
    "s_axis_tlast",
    "s_rst_sync3_reg",
    "s_frame_reg",
    "drop_frame_reg",
    "wr_ptr_inc",
    "wr_ptr_inc_gray"
   ],
   "writes": [
    "s_status_overflow",
    "s_frame_reg",
    "drop_frame_reg",
    "wr_ptr_reg",
    "wr_ptr_commit_reg",
    "wr_ptr_gray_reg"
   ],
   "body": "s_status_overflow <= 1'b0;\nif (s_axis_tready && s_axis_tvalid) begin\n  s_frame_reg <= !s_axis_tlast;\nend\nif (s_rst_sync3_reg) begin\n  if (s_frame_reg && !(s_axis_tready && s_axis_tvalid && s_axis_tlast)) begin\n    drop_frame_reg <= 1'b1;\n  end\n  if (s_axis_tready && s_axis_tvalid && !s_axis_tlast) begin\n    drop_frame_reg <= 1'b1;\n  end\nend\nif (s_axis_tready && s_axis_tvalid) begin\n  if (drop_frame_reg) begin\n    if (s_axis_tlast) begin\n      drop_frame_reg <= 1'b0;\n      s_status_overflow <= 1'b1;\n    end\n  end else begin\n    wr_ptr_reg <= wr_ptr_inc;\n    wr_ptr_commit_reg <= wr_ptr_inc;\n    wr_ptr_gray_reg <= wr_ptr_inc_gray;\n  end\nend\nif (s_rst_sync3_reg) begin\n  wr_ptr_reg <= '0;\n  wr_ptr_commit_reg <= '0;\n  wr_ptr_gray_reg <= '0;\nend"
  },
  {
   "id": "k_mem_wr",
   "kind": "seq",
   "domain": "s",
   "reads": [
    "s_axis_tready",
    "s_axis_tvalid",
    "drop_frame_reg",
    "wr_ptr_reg",
    "s_axis_word"
   ],
   "writes": [
    "mem"
   ],
   "body": "if (s_axis_tready && s_axis_tvalid && !drop_frame_reg) begin\n  mem[wr_ptr_reg[ADDR_WIDTH-1:0]] <= s_axis_word;\nend"
  },
  {
   "id": "k_s_misc",
   "kind": "seq",
   "domain": "s",
   "reads": [
    "overflow_sync1_reg",
    "s_status_overflow"
   ],
   "writes": [
    "overflow_sync1_reg",
    "s_side_ready_reg"
   ],
   "body": "overflow_sync1_reg <= overflow_sync1_reg ^ s_status_overflow;\ns_side_ready_reg <= 1'b1;"
  },
  {
   "id": "k_s_status",
   "kind": "seq",
   "domain": "s",
   "reads": [
    "rd_ptr_sync_bin",
    "wr_ptr_reg",
    "wr_ptr_commit_reg",
    "rd_ptr_conv_reg",
    "s_pause_req"
   ],
   "writes": [
    "rd_ptr_conv_reg",
    "s_status_depth",
    "s_status_depth_commit",
    "s_pause_req_sync1_reg"
   ],
   "body": "rd_ptr_conv_reg <= rd_ptr_sync_bin;\ns_status_depth <= wr_ptr_reg - rd_ptr_conv_reg;\ns_status_depth_commit <= wr_ptr_commit_reg - rd_ptr_conv_reg;\ns_pause_req_sync1_reg <= s_pause_req;"
  },
  {
