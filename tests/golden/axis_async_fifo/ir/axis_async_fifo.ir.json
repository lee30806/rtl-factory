   "body": "m_rst_sync3_reg = !s_side_ready_sync;\nrd_ptr_inc = rd_ptr_reg + 1'b1;\nempty = rd_ptr_gray_reg == wr_ptr_gray_sync2_reg;\nm_axis_tready_pipe = m_axis_tready && !pause_reg;\nm_axis_tvalid_pipe = m_axis_tvalid_pipe_reg[1];\nm_axis_tlast_pipe = m_axis_pipe_reg1[LAST_OFFSET] | m_terminate_frame_reg;\nm_axis_tdata = m_axis_pipe_reg1[DATA_WIDTH-1:0];\nm_axis_tkeep = '1;\nm_axis_tvalid = m_axis_tvalid_pipe && !pause_reg;\nm_axis_tlast = m_axis_tlast_pipe;\nm_axis_tid = m_axis_pipe_reg1[ID_OFFSET +: ID_WIDTH];\nm_axis_tdest = m_axis_pipe_reg1[DEST_OFFSET +: DEST_WIDTH];\nm_axis_tuser = m_terminate_frame_reg ? USER_WIDTH'(USER_BAD_FRAME_VALUE) : m_axis_pipe_reg1[USER_OFFSET +: USER_WIDTH];\nm_status_overflow = overflow_sync3_reg ^ overflow_sync4_reg;\nm_status_bad_frame = 1'b0;\nm_status_good_frame = 1'b0;\nm_pause_ack = pause_reg;"
