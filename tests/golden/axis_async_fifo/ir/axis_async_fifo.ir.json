   "writes": [
    "wr_ptr_sync_bin"
   ],
   "body": "wr_ptr_sync_bin = '0;\nfor (int i = 0; i <= ADDR_WIDTH; i++) begin\n  wr_ptr_sync_bin[i] = ^(wr_ptr_gray_sync2_reg >> i);\nend"
