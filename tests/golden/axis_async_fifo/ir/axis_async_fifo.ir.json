   "body": "if (m_axis_tready_pipe) begin\n  m_axis_tvalid_pipe_reg[1] <= 1'b0;\n  m_terminate_frame_reg <= 1'b0;\nend\nif (m_axis_tready_pipe || !m_axis_tvalid_pipe_reg[1]) begin\n  m_axis_tvalid_pipe_reg[1] <= m_axis_tvalid_pipe_reg[0];\n  m_axis_tvalid_pipe_reg[0] <= 1'b0;\nend\nif (m_axis_tready_pipe || (~m_axis_tvalid_pipe_reg != '0)) begin\n  m_axis_tvalid_pipe_reg[0] <= 1'b0;\n  if (!empty && !m_rst_sync3_reg && !m_drop_frame_reg) begin\n    m_axis_tvalid_pipe_reg[0] <= 1'b1;\n    rd_ptr_reg <= rd_ptr_inc;\n    rd_ptr_gray_reg <= rd_ptr_inc ^ (rd_ptr_inc >> 1);\n  end\nend\nif (m_axis_tvalid_pipe) begin\n  if (m_axis_tlast_pipe && m_axis_tready_pipe) begin\n    m_frame_reg <= 1'b0;\n  end else begin\n    m_frame_reg <= 1'b1;\n  end\nend\nif (m_drop_frame_reg && (m_axis_tready_pipe || !m_axis_tvalid_pipe)) begin\n  m_axis_tvalid_pipe_reg[1] <= 1'b1;\n  m_terminate_frame_reg <= 1'b1;\n  m_drop_frame_reg <= 1'b0;\nend\nif (m_rst_sync3_reg) begin\n  m_axis_tvalid_pipe_reg[0] <= 1'b0;\n  if (m_frame_reg && (!m_axis_tvalid_pipe || (m_axis_tvalid_pipe && !m_axis_tlast_pipe)) && !(m_drop_frame_reg || m_terminate_frame_reg)) begin\n    m_drop_frame_reg <= 1'b1;\n  end\nend\nif (m_rst_sync3_reg) begin\n  rd_ptr_reg <= '0;\n  rd_ptr_gray_reg <= '0;\nend"
